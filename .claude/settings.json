{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Edit(./.env)",
      "Edit(./**/.env)",
      "Bash(cat *.env)",
      "Bash(cat .env*)",
      "Bash(less *.env)",
      "Bash(more *.env)",
      "Bash(head *.env)",
      "Bash(tail *.env)",
      "Bash(grep * .env)",
      "Bash(rg * .env)",
      "Bash(source .env)",
      "Bash(. .env)",
      "Bash(env)",
      "Bash(printenv*)",
      "Bash(docker compose config*)",
      "Bash(docker compose exec * env)",
      "Bash(docker compose exec * printenv*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}